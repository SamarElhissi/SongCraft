# Copy to .env and run commands from the repository root.
# The first real song downloads MusicGen small and the lyrics model. Vocals also use gTTS.
# Set every generator below to fake to run the API without those models.
# lyrics gpt2 and vocals gtts are the previous steps, if you want them back.

SONGCRAFT_DATABASE_URL=sqlite:///./data/songcraft.db
SONGCRAFT_DATA_DIR=./data
SONGCRAFT_DEVICE=auto
SONGCRAFT_MIN_DURATION_SECONDS=5
SONGCRAFT_MAX_DURATION_SECONDS=30
SONGCRAFT_CORS_ORIGINS=http://localhost:5173
SONGCRAFT_MUSIC_GENERATOR=musicgen
SONGCRAFT_LYRICS_GENERATOR=instruct
SONGCRAFT_VOCAL_SYNTHESIZER=melody
SONGCRAFT_MIXER=pydub
SONGCRAFT_BEAT_ANALYZER=librosa
SONGCRAFT_MUSIC_MODEL=facebook/musicgen-small
SONGCRAFT_LYRICS_MODEL=Qwen/Qwen2.5-1.5B-Instruct
SONGCRAFT_JOB_QUEUE=inprocess
